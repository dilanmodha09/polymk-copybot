# Polymarket Copy Trading Bot Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# WALLET CONFIGURATION (REQUIRED)
# ============================================================================

# Source wallet address to monitor and copy trades from
SOURCE_WALLET_ADDRESS=0x1234567890abcdef1234567890abcdef12345678

# Follower wallet address (your wallet that will execute trades)
FOLLOWER_WALLET_ADDRESS=0xabcdef1234567890abcdef1234567890abcdef12

# Follower wallet private key (KEEP THIS SECRET!)
# This is used to sign transactions
FOLLOWER_WALLET_PRIVATE_KEY=your_private_key_here

# ============================================================================
# POLYMARKET & BLOCKCHAIN CONFIGURATION
# ============================================================================

# Polymarket CLOB API URL
POLYMARKET_API_URL=https://clob.polymarket.com

# Polygon RPC endpoint (get from Infura, Alchemy, or QuickNode)
POLYGON_RPC_URL=https://polygon-rpc.com

# Polygon chain ID (137 for mainnet, 80001 for Mumbai testnet)
POLYMARKET_CHAIN_ID=137

# ============================================================================
# SCALING PARAMETERS
# ============================================================================

# Scaling method (currently only "proportional" is supported)
SCALING_METHOD=proportional

# Minimum order size in USDC (Polymarket typically requires $1 minimum)
MIN_ORDER_SIZE_USDC=1.0

# Maximum position size as percentage of follower wallet (e.g., 20 = 20%)
MAX_POSITION_SIZE_PERCENT=20.0

# ============================================================================
# RISK CONTROLS
# ============================================================================

# Maximum percentage of wallet that can be used at once (e.g., 80 = 80%)
MAX_WALLET_UTILIZATION_PERCENT=80.0

# Daily loss limit before kill-switch activates (e.g., 10 = 10%)
DAILY_LOSS_LIMIT_PERCENT=10.0

# Number of consecutive API errors before circuit breaker triggers
CIRCUIT_BREAKER_ERROR_THRESHOLD=5

# ============================================================================
# EXECUTION PARAMETERS
# ============================================================================

# Maximum acceptable slippage percentage (e.g., 2 = 2%)
SLIPPAGE_TOLERANCE_PERCENT=2.0

# Maximum gas price in Gwei
MAX_GAS_PRICE_GWEI=500.0

# Number of retry attempts for failed trades
RETRY_ATTEMPTS=3

# Delay between retries in seconds
RETRY_DELAY_SECONDS=2.0

# ============================================================================
# MONITORING & POLLING
# ============================================================================

# Interval for polling source wallet trades (in seconds)
POLLING_INTERVAL_SECONDS=5.0

# Interval for checking wallet balances (in seconds)
BALANCE_CHECK_INTERVAL_SECONDS=30.0

# ============================================================================
# DATABASE
# ============================================================================

# Database URL (SQLite example, use PostgreSQL for production)
DATABASE_URL=sqlite:///./polymarket_copybot.db
# For PostgreSQL: postgresql://user:password@localhost:5432/polymarket_copybot

# ============================================================================
# LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/copybot.log

# ============================================================================
# EMERGENCY CONTROLS
# ============================================================================

# Emergency shutdown flag (set to true to stop all trading immediately)
EMERGENCY_SHUTDOWN=false
